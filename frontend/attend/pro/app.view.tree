$attend_pro_app $mol_page
	attr *
		^
		mol_theme <= theme_name \$mol_theme_light
	title \AttendPro
	tools <= app_tools /
		<= Network $mol_view
			sub / <= network_label \● сеть
		<= Theme_toggle $mol_button_minor
			title <= theme_button_title \Тёмная тема
			click? <=> theme_toggle? null
		<= Logout $mol_button_minor
			title \Выйти
			click? <=> logout? null
	body /
		<= Intro $mol_view
			sub /
				<= Intro_title $mol_view sub / \Проверяемая посещаемость
				<= Intro_text $mol_view sub / \Отметка создаётся на устройстве и может дождаться сети. Портал принимает её только после проверки всей цепочки подписей.
		<= Main $mol_list
			rows <= rows /
	-
	Loading $mol_view sub / \Загрузка локального состояния…
	Error $mol_view sub / <= error_text? \
	Identity $mol_view
		sub /
			<= Identity_name $mol_view sub / <= identity_name \
			<= Identity_role $mol_view sub / <= identity_role \
	Accounts_title $mol_view sub / \Тестовый вход через mock SSO
	Account* $mol_button_major
		title <= account_title* \
		click? <=> account_login*? null
	-
	Lesson $mol_view
		sub /
			<= Lesson_badge $mol_view sub / <= lesson_state \
			<= Lesson_title $mol_view sub / <= lesson_title \
			<= Lesson_meta $mol_view sub / <= lesson_meta \
	No_lesson $mol_view sub / \Сейчас активной пары нет. Преподаватель может запустить тестовую пару.
	-
	Teacher_explain $mol_view sub / \Устройство преподавателя выпускает короткоживущий QR-вызов. QR можно продолжать показывать без сети, пока действует заранее полученное разрешение пары.
	Test_lesson_explain $mol_view sub / \Тестовая кнопка устанавливает начало пары на текущий момент, окончание — через 90 минут, получает новое разрешение и останавливает старый показ QR.
	Start_now $mol_button_major
		title <= start_now_title \Запустить тестовую пару на 90 минут
		click? <=> start_now? null
	Action_status $mol_view sub / <= action_status? \
	Qr_kind_explain $mol_view sub / \«Вход» фиксирует прибытие студента, «Выход» — уход. Это два разных типа подписанного события, поэтому для них нужны отдельные QR.
	Qr_actions $mol_view
		sub /
			<= Entry_qr
			<= Exit_qr
	Entry_qr $mol_button_major
		title <= entry_qr_title \Показывать QR «Вход»
		click? <=> entry_qr? null
	Exit_qr $mol_button_major
		title <= exit_qr_title \Показывать QR «Выход»
		click? <=> exit_qr? null
	Stop_qr $mol_button_minor
		title \Остановить показ QR
		click? <=> stop_qr? null
	Qr $mol_image
		uri <= qr_uri? \
		title \Подписанный QR AttendPro
	Qr_hint $mol_view sub / <= qr_hint \
	Qr_raw $mol_textarea
		value? <=> qr_raw? \
		enabled false
	-
	Student_explain $mol_view sub / \Сканирование проверяет подпись преподавателя прямо на телефоне. Затем телефон подписывает собственное утверждение и сохраняет его в IndexedDB до синхронизации.
	Camera $mol_video_camera
		facing \environment
	Start_scan $mol_button_major
		title <= scan_button_title \Включить камеру и искать QR
		click? <=> scan_start? null
	Qr_input $mol_textarea
		hint \Для теста можно вставить сюда JSON из поля преподавателя
		value? <=> qr_input? \
	Accept_qr $mol_button_minor
		title <= accept_qr_title \Проверить и подписать вставленный QR
		enabled <= accept_qr_enabled true
		click? <=> qr_accept? null
	Scan_status $mol_view sub / <= scan_status? \
	Pending $mol_view sub / <= pending_label \
	Sync $mol_button_major
		title \Синхронизировать сохранённые отметки
		enabled <= sync_enabled true
		click? <=> sync_now? null
	History $mol_view sub / <= history_label \
