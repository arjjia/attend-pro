flowchart TB
    TITLE["Легенда текущей архитектуры AttendPro"]
    CLIENT["👤 Клиент<br/>браузер преподавателя / студента"]
    UI["🐳 Интерфейс<br/>nginx, $mol SPA/PWA, Service Worker"]
    SERVICE["🐳 Микросервис<br/>FastAPI Portal API"]
    MODULE["⚙️ Модуль сервиса<br/>proof verifier, security, ORM, seed, migrations"]
    BRIDGE["🐳 Мост / адаптер<br/>Giper evidence adapter"]
    STORAGE["🐳 Хранилище<br/>IndexedDB, PostgreSQL, volumes, private Land"]
    FUTURE["🚀 Целевое развитие<br/>OIDC, Modeus, Giper relay + Web Worker"]
    LEGACY["📜 Неактивный исходный контур<br/>frontend/src не входит в MAM-сборку"]

    TITLE --> CLIENT
    CLIENT --> UI
    UI --> SERVICE
    SERVICE --> MODULE
    MODULE --> STORAGE
    BRIDGE --> STORAGE
    STORAGE --> FUTURE
    FUTURE --> LEGACY

