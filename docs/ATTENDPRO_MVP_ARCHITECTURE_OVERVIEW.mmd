        direction LR
        T["Преподаватель<br/>device key · ENTRY / EXIT"]
        S["Студент<br/>device key · verify + claim"]
    end

    subgraph F["frontend :3000 · $mol SPA/PWA"]
        direction LR
        APP["frontend/attend/pro<br/>Root.view.tree + Root.view.ts"]
        LOCAL["Web Crypto ES256 · RFC 8785<br/>IndexedDB: keys, permit, outbox, decisions<br/>$mol_offline · QR · camera"]
        GIPER["Giper evidence adapter<br/>private Land<br/>UI publish выключен до Web Worker"]
        APP --> LOCAL
        APP -.-> GIPER
    end

    subgraph B["backend :8000 · FastAPI Portal API"]
        direction LR
        API["mock SSO · devices · lessons<br/>permits · attendance sync"]
        VERIFY["proof verifier + policy<br/>portal signer · ES256"]
        API --> VERIFY
    end

    subgraph D["Authority и хранение"]
        direction LR
        PG[("PostgreSQL 17<br/>8 таблиц · claims · decisions · audit")]
        VOL["portal_keys + postgres_data<br/>персистентные volumes"]
        PG <--> VOL
    end

    subgraph FUT["Следующие интеграции"]
        direction LR
        X["Целевые adapters<br/>University SSO / OIDC · Modeus"]
        R["Giper relay + Web Worker"]
    end

    T --> APP
    S --> APP
